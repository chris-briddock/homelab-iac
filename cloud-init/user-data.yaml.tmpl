#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.local
manage_etc_hosts: true

users:
  - name: ${vm_user}
    groups: [wheel]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
packages:
  - podman
  - qemu-guest-agent
  # Provides the dnf5-automatic.timer enabled in runcmd below (daily host
  # package updates; /etc/dnf/automatic.conf from write_files sets
  # apply_updates=yes). Not part of the Fedora Cloud base image.
  - dnf5-plugin-automatic
%{ for p in extra_packages ~}
  - ${p}
%{ endfor ~}

write_files:
  # systemd-resolved: pin the internal DNS as the link-local resolver for
  # lab.internal and demote any public fallback (1.1.1.1) to a low-priority
  # catch-all routing domain (~.). netplan (network-config.yaml.tmpl) can't
  # express this split, so without this drop-in a public server listed in
  # DNS= would sometimes have its NXDOMAIN for lab.internal accepted as
  # final. The drop-in overrides the link config regardless of netplan.
  - path: /etc/systemd/resolved.conf.d/50-lab-dns.conf
    permissions: "0644"
    content: |
      [Resolve]
      DNS=${join(" ", [for d in dns : d if can(regex("^192\\.168\\.", d))])}
      Domains=lab.internal
      %{~ if length([for d in dns : d if !can(regex("^192\\.168\\.", d))]) > 0 ~}
      # Public fallback: only queried for names outside lab.internal, and only
      # when the internal DNS above is unreachable (hence the trailing ~.).
      FallbackDNS=${join(" ", [for d in dns : d if !can(regex("^192\\.168\\.", d))])}
      %{~ endif ~}
  - path: /etc/modules-load.d/br_netfilter.conf
    permissions: "0644"
    content: |
      br_netfilter
  - path: /etc/sysctl.d/99-bridge-nf.conf
    permissions: "0644"
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1
  # dnf5-automatic defaults to download-only (see
  # /usr/share/dnf5/dnf5-plugins/automatic.conf); override via the single
  # supported override file. reboot stays "never" (distro default) --
  # kernel upgrades take effect on the next manual/maintenance reboot.
  - path: /etc/dnf/automatic.conf
    permissions: "0644"
    content: |
      [commands]
      apply_updates = yes
%{ for f in extra_files ~}
  - path: ${f.path}
    permissions: "${f.permissions}"
    content: |
      ${indent(6, f.content)}
%{ endfor ~}
%{ if length(containers) > 0 ~}
  - path: /etc/containers/systemd/vmnet.network
    permissions: "0644"
    content: |
      [Network]
%{ if length(dns) > 0 ~}
      # Pin aardvark-dns upstreams; without this, podman captures whatever
      # resolv.conf held when the network first came up, racing cloud-init's
      # static profile.
%{ for d in dns ~}
      DNS=${d}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ for c in containers ~}
  - path: /etc/containers/systemd/${c.name}.container
    permissions: "0644"
    content: |
      [Unit]
      Description=${c.name} container (managed by podman quadlet)
      After=network-online.target
      Wants=network-online.target
%{ for d in c.depends_on ~}
      # Wants (not Requires): a hard dependency propagates `systemctl stop`
      # to dependents, which then stay down -- restarting a database or app
      # container must not silently kill the caddy in front of it.
      Wants=${d}.service
      After=${d}.service
%{ endfor ~}
      # [Unit]-only option: systemd refuses manual `systemctl stop` /
      # `kill` on the unit by default. A compromised process inside the
      # container calling systemd would've needed CAP_KILL against host
      # PID 1 *and* a working mount of the host systemd D-Bus socket,
      # neither of which it has -- but a manual stop by the operator is a
      # documented way to render a quadlet-managed container unrecoverable
      # without a `daemon-reload`, so we refuse it outright. Use
      # `systemctl restart` for intentional bounce.
      RefuseManualStop=yes

      [Container]
      Image=${c.image}
      ContainerName=${c.name}
      # Podman's implicit default bridge network has DNS disabled; use a
      # proper user-defined network (DNS enabled by default) so containers
      # can resolve each other by name.
      Network=vmnet.network
%{ for p in c.ports ~}
      PublishPort=${p}
%{ endfor ~}
%{ for k, v in c.environment ~}
      Environment=${k}="${v}"
%{ endfor ~}
%{ for vol in c.volumes ~}
      Volume=${vol}
%{ endfor ~}
%{ for a in c.extra_args ~}
      PodmanArgs=${a}
%{ endfor ~}
%{ if c.user != "" ~}
      User=${c.user}
%{ endif ~}
%{ if c.entrypoint != "" ~}
      Entrypoint=${c.entrypoint}
%{ endif ~}
%{ if c.command != "" ~}
      Exec=${c.command}
%{ endif ~}
      AutoUpdate=registry

      [Service]
%{ if c.oneshot ~}
      # Oneshot bootstrap sidecar: run once at boot, stay "active" via
      # RemainAfterExit so dependents ordering after it see success.
      # NOTE: no Restart= here -- Type=oneshot with any Restart= value is a
      # systemd config error, so Restart=always stays exclusive to the
      # long-running containers below (where it is already emitted).
      Type=oneshot
      RemainAfterExit=yes
%{ else ~}
      Restart=always
%{ endif ~}
      TimeoutStartSec=900

      # NO unit-level hardening here on the [Service] section, once and
      # for all. Two lessons from 2026-08-31/2026-09-01:
      #
      # 1. Directives like ProtectSystem=strict/PrivateDevices/
      #    ProtectKernelTunables/ProtectControlGroups/NoNewPrivileges
      #    apply to the PODMAN PROCESS on the host, not to the
      #    container. Podman central to quadlet starts writes/locks
      #    under /var/lib/containers, /sys/fs/cgroup, /run/libpod and
      #    configures sysctls on its own veth; sandbox either of
      #    those and podman can't start.
      #
      # 2. Empirical testing of the "safe" subset (PrivateTmp /
      #    LockPersonality / RestrictSUIDSGID / ProtectKernelModules /
      #    ProtectHome / ProtectSystem=full / RefuseManualStop) was
      #    done one directive at a time on postgres-vm and each
      #    individually passed.  Rolling ALL of them fleet-wide at
      #    once still left coredns + caddy + every container failing
      #    across the rebuilt VMs with unexplained "Job for
      #    coredns.service failed because the control process exited
      #    with error code" — meaning: one or more of the subset
      #    breaks podman in a multi-directive interaction that single-
      #    directive smoke tests did not catch.  Bisecting that
      #    matrix is not worth the complexity in this template.
      #
      # The only sandbox knob we keep is RefuseManualStop=yes — and it
      # lives in [Unit], not [Service]. RefuseManualStop=true only makes
      # systemd reject `systemctl stop` against the unit; the operator
      # uses `systemctl restart` for intentional bounce.  It does not
      # touch podman's path and is the documented way to flag a quadlet
      # as "managed by the toolchain, not by hand".
      #
      # If a future audit wants per-container hardening, do it at the
      # Container level (SELinux label, DropCapability on Container,
      # NoNewPrivileges on Container, not on Unit) where it actually
      # constrains what runs INSIDE the container, not the runtime.

      [Install]
      WantedBy=multi-user.target
%{ endfor ~}

runcmd:
  - [ modprobe, br_netfilter ]
  - [ sysctl, --system ]
  # Activate any CA anchors delivered via write_files (podman validates the
  # HTTPS registry mirror against the system trust store).
  - [ update-ca-trust ]
  - [ systemctl, enable, --now, qemu-guest-agent ]
  # NetworkManager's auto-generated "Wired connection 1" (DHCP) profile races
  # with cloud-init's own connection profile for the same device; force the
  # cloud-init-managed one to win.
%{ if length(dns) > 0 ~}
  # Router advertisements inject the ISP's IPv6 resolver, which NXDOMAINs
  # internal names; only the configured DNS servers may be used.
  - [ nmcli, con, mod, "cloud-init ${iface}", ipv6.ignore-auto-dns, "yes" ]
%{ endif ~}
  - [ nmcli, con, up, "cloud-init ${iface}" ]
  - [ systemctl, daemon-reload ]
  # Automatic updates, two layers:
  #  - host packages: dnf5-automatic applies them daily (config above).
  #  - container images: every quadlet carries AutoUpdate=registry; this
  #    timer runs `podman auto-update` daily, pulling new images and
  #    restarting only the affected containers.
  - [ systemctl, enable, --now, dnf5-automatic.timer ]
  - [ systemctl, enable, --now, podman-auto-update.timer ]
%{ for r in extra_runcmd ~}
  - ${jsonencode(r)}
%{ endfor ~}
%{ for c in containers ~}
  - [ systemctl, start, "${c.name}.service" ]
%{ endfor ~}
